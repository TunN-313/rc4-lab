# ==============================================================================
# RC4 LAB - MÔI TRƯỜNG CẤU HÌNH MẪU (.env.example)
# Sao chép tệp này thành .env và điền các giá trị thực tế của bạn
# TUYỆT ĐỐI KHÔNG COMMIT FILE .env CHỨA KHÓA BÍ MẬT LÊN GIT REPOSITORY
# ==============================================================================

# 1. Cấu hình Firebase (Nếu tự triển khai độc lập ngoài AI Studio)
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseApiKeyPlaceholder"
VITE_FIREBASE_AUTH_DOMAIN="your-app-project-id.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app-project-id"
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"
VITE_FIREBASE_STORAGE_BUCKET="your-app-project-id.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# 2. Cấu hình AI Studio / Máy chủ (Tùy chọn)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
